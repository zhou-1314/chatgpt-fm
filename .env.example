INTERPRET_PROVIDER=codex
# INTERPRET_PROVIDER=claude
# INTERPRET_PROVIDER=deepseek

CODEX_MODEL=gpt-5.5
# Options for gpt-5.5: none, low, medium, high, xhigh
CODEX_REASONING_EFFORT=high

CLAUDE_MODEL=claude-sonnet-4-6
# Options: empty string to disable, think hard, ultrathink
CLAUDE_REASONING_EFFORT=ultrathink

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Options: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-pro
# Thinking options: enabled, disabled
DEEPSEEK_THINKING=enabled
# Reasoning options: high, max. Compatibility: low/medium map to high, xhigh maps to max.
DEEPSEEK_REASONING_EFFORT=high

# ── 发布目标（不填就用 config.py 里的默认值）──────────────────────────────
# 换成你自己的仓库时改这两个就够，feed 和音频地址会自动跟着变
# GITHUB_OWNER=zhou-1314
# GITHUB_REPO=chatgpt-fm
# 音频挂在哪个 Release tag 下
# AUDIO_RELEASE_TAG=audio
# 想用自定义域名 / 把音频挪到对象存储时，直接覆盖这两个地址
# FEED_BASE_URL=https://zhou-1314.github.io/chatgpt-fm
# AUDIO_BASE_URL=https://github.com/zhou-1314/chatgpt-fm/releases/download/audio
